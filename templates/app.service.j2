[Unit]
Description={{ springboot_application_name }}
After=syslog.target

[Service]
User={{ springboot_user }}
ExecStart="{{ springboot_deploy_folder }}/{{ springboot_application_jar }} {{ springboot_extra_args}}"
Environment=SPRING_CONFIG_LOCATION={{ springboot_deploy_folder }}/application.yml
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
